# ── Production (Vercel) — Supabase database ─────────────────────────────
# Copy values from your local .env into Vercel → Settings → Environment Variables
# Enable for: Production, Preview, Development

SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Session cookies (min 32 random chars — use a strong value on Vercel, not the local default)
SESSION_SECRET=

# Serverless: no local SQLite / no on-prem SQL from Vercel
DISABLE_SQLITE=true

# ── Email / OTP (login + maintenance reminders) ─────────────────────────
SMTP_EMAIL=
SMTP_PASSWORD=
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
OTP_FROM_EMAIL=
OTP_USE_SMTP=true

# Production site URL (for CORS / links in emails)
APP_BASE_URL=https://pg-group-aems-system.vercel.app

# Optional: protect maintenance cron endpoints
# CRON_SECRET=

# ── Local dev only (do NOT add SQL_* to Vercel — localhost is not reachable) ──
# USE_SQL_SERVER=true
# SQL_SERVER=localhost
# SQL_INSTANCE=AEMS
# SQL_DATABASE=AEMS
# SQL_USER=
# SQL_PASSWORD=
# SQL_ENCRYPT=false
# OTP_LOG_TO_CONSOLE=true

# ── Legacy Google Sheets (not needed when Supabase is configured) ───────
# SPREADSHEET_ID=
# USERS_SHEET_GID=
# GAS_WEBAPP_URL=
