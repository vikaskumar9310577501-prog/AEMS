{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "server.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/server.ts"
    },
    {
      "source": "/scan/:path*",
      "destination": "/server.ts"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
